---
import "../styles.css";
// import Canonical from "../components/Canonical";
const {
  title = "Free Academic Calculators",
  description = "Free online academic calculators for GPA and percentage conversions",
  keywords = "",
  ogImage = "/og-image.png", // Default OG image
  ogImageAlt = null, // Accessible description of the OG image
  lang = "en", // Document language
  isCalculator = null, // Overrides the URL sniff below; set by CalculatorLayout
  currentUrl, // Current page URL
  additionalSchema = null, // Page-specific JSON-LD (object or array of objects)
  noindex = false,
} = Astro.props;

// Pages may pass a single schema object or several; normalise to an array.
const extraSchemas = (Array.isArray(additionalSchema) ? additionalSchema : [additionalSchema]).filter(
  Boolean
);

// Format current URL for canonical link with fallbacks
const siteUrl = "https://rref-calculator.com"; // Replace with your domain
const canonicalURL = currentUrl ? `${siteUrl}${currentUrl}` : siteUrl;

// Pages may pass either a site-relative path or a full URL.
const ogImageURL = /^https?:\/\//.test(ogImage) ? ogImage : `${siteUrl}${ogImage}`;

// Create JSON-LD data objects first
const mainSchemaData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Free Academic Calculators",
  url: siteUrl,
  description: description,
  applicationCategory: "EducationalApplication",
  operatingSystem: "Any",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  creator: {
    "@type": "Organization",
    name: "Free Academic Calculators",
    url: siteUrl,
  },
};

// Calculator-specific schema data. Pages can state it outright; otherwise we
// fall back to looking at the URL, which misses non-English sections.
const isCalculatorPage =
  isCalculator === null ? Boolean(currentUrl?.includes("calculator")) : isCalculator;
const calculatorSchemaData = isCalculatorPage
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: title,
      applicationCategory: "EducationalApplication",
      operatingSystem: "Any",
      description: description,
      inLanguage: lang,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "4.9",
        ratingCount: "348",
      },
    }
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0ea5e9" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Calculators" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:site_name" content="Free Academic Calculators" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Preconnect to critical origins -->
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Check localstorage first
      const theme = localStorage.getItem("theme");
      if (theme) {
        document.documentElement.className = theme;
      } else {
        // If no theme in localStorage, check system preference
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.className = "dark";
          localStorage.setItem("theme", "dark");
        } else {
          document.documentElement.className = "light";
          localStorage.setItem("theme", "light");
        }
      }
    </script>

    <!-- JSON-LD Schema - Fixed to use set:html with proper JSON data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(mainSchemaData)}
    />

    <!-- Calculator-specific Schema (for calculator pages) -->
    {
      calculatorSchemaData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(calculatorSchemaData)}
        />
      )
    }

    <!-- Page-specific Schema (FAQ, HowTo, BreadcrumbList, ...) -->
    {
      extraSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CY5QBMQ9F9"
    ></script>
    <script is:inline>
      try {
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", "G-CY5QBMQ9F9");
      } catch (e) {
        console.error("Analytics error:", e);
        // Prevent analytics errors from breaking the page
      }
    </script>

    <!-- adsense with error handling -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9779862910631944"
      crossorigin="anonymous"
      onerror="this.onerror=null; console.warn('AdSense failed to load');"
    ></script>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    <!-- <Canonical client:only /> -->

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/philfung/add-to-homescreen@3.3/dist/add-to-homescreen.min.css"
    />
    <script
      src="https://cdn.jsdelivr.net/gh/philfung/add-to-homescreen@3.3/dist/add-to-homescreen.min.js"
    ></script>
  </head>
  <body>
    <slot />
    
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        window.AddToHomeScreenInstance = window.AddToHomeScreen({
          appName: 'Free Calculators',
          appNameDisplay: 'standalone',
          appIconUrl: 'apple-touch-icon.png',
          assetUrl: 'https://cdn.jsdelivr.net/gh/philfung/add-to-homescreen@3.3/dist/assets/img/', 
          maxModalDisplayCount: -1,
          allowClose: true,
          showArrow: true,
        });
        });
    </script>
</body>
  </body>
</html>
